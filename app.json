{
  "expo": {
    "name": "Screaming",
    "slug": "screaming",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "screaming",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050506",
    "primaryColor": "#5E6AD2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.screaming.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Screaming uses the microphone to measure how loud you scream. Audio is never recorded, saved, or uploaded."
      }
    },
    "android": {
      "package": "com.screaming.app",
      "adaptiveIcon": {
        "backgroundColor": "#050506",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Screaming uses the microphone to measure how loud you scream. Audio is never recorded, saved, or uploaded."
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#050506"
        }
      ]
    ]
  }
}
